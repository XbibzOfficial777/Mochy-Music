{
  "name": "mochi-bibz-desktop",
  "productName": "Mochi Bibz",
  "version": "0.1.1",
  "description": "Mochi Bibz desktop music player",
  "homepage": "https://github.com/XbibzOfficial777/Mochy-Music",
  "author": { "name": "XbibzOfficial777", "email": "XbibzOfficial777@users.noreply.github.com" },
  "license": "GPL-3.0-only",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "check": "node scripts/check-source.mjs",
    "test": "node --test tests/core.test.cjs tests/playback.test.cjs",
    "test:e2e": "playwright test",
    "test:online": "node scripts/check-online.cjs",
    "test:desktop": "playwright test tests/desktop.spec.cjs",
    "dist": "electron-builder --publish never"
  },
  "dependencies": { "music-metadata": "12.7.0" },
  "devDependencies": { "electron": "45.4.1", "electron-builder": "26.18.0", "@playwright/test": "1.65.1" },
  "build": {
    "appId": "com.xbibz.mochi.desktop",
    "asar": true,
    "files": ["src/**", "renderer/**", "package.json", "LICENSE"],
    "extraResources": [{ "from": "resources", "to": "resources" }],
    "directories": { "output": "dist" },
    "artifactName": "Mochi-Bibz-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [{ "ext": ["mp3", "flac", "wav", "ogg", "opus", "m4a", "aac", "webm"], "name": "Audio", "role": "Viewer" }],
    "win": { "target": ["nsis", "zip"], "icon": "resources/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": ["AppImage", "deb"], "category": "AudioVideo", "icon": "resources/icon.png" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.music", "icon": "resources/icon.png", "identity": null }
  }
}
