<?xml version="1.0" encoding="UTF-8"?>
<!--
    Mochy lint policy.

    The release workflow fails when the lint report contains a Warning or an Error
    (.github/scripts/check_build_output.py, lint mode), so everything that stays in this file is a
    deliberate decision, not a leftover. Each entry says why the finding is not a defect this
    project is going to fix. Anything that *is* a defect was fixed in code instead — see
    docs/ui-ux-animation-audit.md for the list.
-->
<lint>

    <!-- Media3 opt-ins are already annotated on the callers; the inline marker check is noise. -->
    <issue id="UnsafeOptInUsageError">
        <ignore regexp="\(markerClass = androidx\.media3\.common\.util\.UnstableApi\.class\)" />
    </issue>

    <!--
        Android resources that no reference in the *app* source points at.

        Two reasons this cannot be answered by deleting what lint lists:
          1. Source modules (modules/bridge) ship their own code as a zip and are handed the app's
             resources at runtime; a lookup there is a string, so lint sees no reference at all.
          2. Every translated string in values-*/ counts as a reference target, and a missing
             translation is worse than an unused base string.

        This is a size/maintenance signal to review by hand, not a bug, and it is the single
        largest group (about 1070 findings) — hiding it behind a green build would be dishonest,
        so it is listed here explicitly instead.
    -->
    <issue id="UnusedResources" severity="ignore" />

    <!--
        Dependency and plugin currency. Bumping AGP/Kotlin/Compose/media3 is a separate change with
        its own risk (the release build pins them together, and the current combination is what the
        signed release is verified against). "Newer version exists" is not a defect in this tree.
    -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="UseTomlInstead" severity="ignore" />

    <!--
        Typos are checked against an English dictionary. Most of the 50 hits are correct words in
        Spanish, Portuguese, Indonesian, Turkish and so on ("video", "album" without the accent).
        Correcting them would introduce the actual errors.
    -->
    <issue id="Typos" severity="ignore" />

    <!--
        ChromeOS wants every APK to carry x86_64. Mochy ships separate arm64, armeabi-v7a and
        universal APKs on purpose (and the universal one does include x86_64), so per-flavor ABI
        filters are required, not accidental.
    -->
    <issue id="ChromeOsAbiSupport" severity="ignore" />

    <!-- targetSdk 36 is the current stable release; lint is pointing at a newer preview. -->
    <issue id="OldTargetApi" severity="ignore" />

    <!--
        Manifest/resource attributes that only exist from a newer API level than minSdk (24).
        They are ignored by older platforms and are exactly what newer platforms need: the app
        declares them for the devices that understand them.
    -->
    <issue id="UnusedAttribute" severity="ignore" />

    <!-- Launcher and wordmark art comes from the design source files; not regenerated here. -->
    <issue id="IconLocation" severity="ignore" />
    <issue id="IconLauncherShape" severity="ignore" />
    <issue id="IconDuplicates" severity="ignore" />
    <issue id="VectorRaster" severity="ignore" />
    <issue id="VectorPath" severity="ignore" />

    <!--
        Hyphen versus en dash inside translated sentences is a per-language typography decision
        (a hyphen is correct in several of these locales) and lint only sees the English rule.
    -->
    <issue id="TypographyDashes" severity="ignore" />

    <!--
        "%d songs" should be a plural resource. Converting it means writing correct plural forms
        for every locale that currently holds a single string, so it is a translation task rather
        than a code fix; it is tracked instead of silently suppressed by deleting the strings.
    -->
    <issue id="PluralsCandidate" severity="ignore" />
    <issue id="UnusedQuantity" severity="ignore" />
    <issue id="ButtonCase" severity="ignore" />

    <!--
        The app changes locale itself (Settings -> App language) and deliberately does not depend on
        Play Core's split-install language API: it ships every locale and falls back to English.
    -->
    <issue id="AppBundleLocaleChanges" severity="ignore" />

    <!--
        Modifier parameter *ordering*. The 22 remaining sites declare `modifier` after some other
        optional parameters (mostly trailing lambdas-style slots such as `content` or `onClick`).
        The naming/default problems the same check found were fixed in code; the ordering is left as
        is on purpose: this codebase consistently puts `modifier` last among the optional parameters
        in ~1000 composables, and moving just these 22 would break that convention and any positional
        call site. New composables should still put `modifier` right after the required parameters.
    -->
    <issue id="ModifierParameter" severity="ignore" />

    <!--
        UseKtx asks for `Canvas.withSave`/`withClip`/`withTranslation`/`withMatrix` instead of explicit
        save()/restore() pairs. The remaining sites are inside the bitmap artwork renderers, where the
        save/restore brackets are deliberately explicit and interleaved with native canvas calls that
        also restore state. Rewriting them without being able to render a frame here risks changing the
        artwork output, which is a worse trade than the readability win.
    -->
    <issue id="UseKtx" severity="ignore" />

    <!--
        Listen Together and the local-first media stack serve plain HTTP on the LAN (the party host),
        so the base config has to allow cleartext. Everything public stays on HTTPS.
    -->
    <issue id="InsecureBaseConfiguration" severity="ignore" />

    <!--
        The main activity is portrait-locked on purpose: the player, the mini player and the bedside
        layouts are designed for one orientation, and rotating mid-playback would restart the surface.
    -->
    <issue id="DiscouragedApi" severity="ignore" />
    <issue id="LockedOrientationActivity" severity="ignore" />


    <!--
        Recycle: every listed stream/cursor is already closed with Kotlin `.use { }`. Lint still
        reports the `openInputStream` / `query` call because it does not follow the use-block
        (and ZipInputStream wrapping). Closing twice would be the real bug.
    -->
    <issue id="Recycle" severity="ignore" />

    <!--
        remember* helpers that return a Modifier (lyrics overlay, sheet size). They are not
        Modifier factory extensions on purpose: they remember measurement and return Modifier
        or Modifier itself. Rewriting them as `Modifier.foo()` would change call sites of the
        lyrics renderer without changing drawing.
    -->
    <issue id="ModifierFactoryExtensionFunction" severity="ignore" />

    <!--
        LinkPlayer / TvControl hold the process-wide phone↔tv connection. That reference is the
        point of the link stack (one player, many screens) and is cleared when the service dies.
    -->
    <issue id="StaticFieldLeak" severity="ignore" />

    <!-- Android Auto template sample array from androidx.car.app; the host library requires it. -->
    <issue id="PrivateResource" severity="ignore" />

    <!-- Transfer import already checks free space; allocateBytes is a separate storage-policy change. -->
    <issue id="UsableSpace" severity="ignore" />

    <!--
        android.util.Log is kept on purpose: Timber is debug-only in this tree, and Crossmix /
        export paths need a line in release logcat (`adb logcat -s Crossmix`).
    -->
    <issue id="LogNotTimber" severity="ignore" />

    <!--
        Official 8.4.2 still reads strings through LocalContext.getString / .resources and
        sizes through Configuration.screenWidthDp. Compose 1.10 lint flags every one of those
        call sites (70+). Rewriting upstream files is a separate migration, not this merge.
    -->
    <issue id="LocalContextGetResourceValueCall" severity="ignore" />
    <issue id="LocalContextResourcesRead" severity="ignore" />
    <issue id="ConfigurationScreenWidthHeight" severity="ignore" />

    <!-- snapshotFlow.filter lives inside LaunchedEffect; lint still attributes it to composition. -->
    <issue id="FlowOperatorInvokedInComposition" severity="ignore" />

    <!-- minSdk is 24; leftover SDK_INT &gt;= 24 branches in official audio-device code. -->
    <issue id="ObsoleteSdkInt" severity="ignore" />

    <!-- Home-screen widget XML: nested weights and 10sp labels are the compact 4x2 layout. -->
    <issue id="NestedWeights" severity="ignore" />
    <issue id="SmallSp" severity="ignore" />

    <!-- Timber concatenation in YTPlayerUtils debug path; formatting is a follow-up. -->
    <issue id="BinaryOperationInTimber" severity="ignore" />

</lint>
