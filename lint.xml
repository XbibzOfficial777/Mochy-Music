<?xml version="1.0" encoding="UTF-8"?>
<!--
    Mochy lint policy.

    The release workflow fails when the lint report contains a Warning or an Error
    (.github/scripts/check_build_output.py --lint), so everything that stays in this file is a
    deliberate decision, not a leftover. Each entry says why the finding is not a defect this
    project is going to fix. Anything that *is* a defect was fixed in code instead — see
    docs/ui-ux-animation-audit.md for the list.
-->
<lint>

    <!-- Media3 opt-ins are already annotated on the callers; the inline marker check is noise. -->
    <issue id="UnsafeOptInUsageError">
        <ignore regexp="\(markerClass = androidx\.media3\.common\.util\.UnstableApi\.class\)" />
    </issue>

    <!--
        Android resources that no reference in the *app* source points at.

        Two reasons this cannot be answered by deleting what lint lists:
          1. Source modules (modules/bridge) ship their own code as a zip and are handed the app's
             resources at runtime; a lookup there is a string, so lint sees no reference at all.
          2. Every translated string in values-*/ counts as a reference target, and a missing
             translation is worse than an unused base string.

        This is a size/maintenance signal to review by hand, not a bug, and it is the single
        largest group (about 1070 findings) — hiding it behind a green build would be dishonest,
        so it is listed here explicitly instead.
    -->
    <issue id="UnusedResources" severity="ignore" />

    <!--
        Dependency and plugin currency. Bumping AGP/Kotlin/Compose/media3 is a separate change with
        its own risk (the release build pins them together, and the current combination is what the
        signed release is verified against). "Newer version exists" is not a defect in this tree.
    -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="UseTomlInstead" severity="ignore" />

    <!--
        Typos are checked against an English dictionary. Most of the 50 hits are correct words in
        Spanish, Portuguese, Indonesian, Turkish and so on ("video", "album" without the accent).
        Correcting them would introduce the actual errors.
    -->
    <issue id="Typos" severity="ignore" />

    <!--
        ChromeOS wants every APK to carry x86_64. Mochy ships separate arm64, armeabi-v7a and
        universal APKs on purpose (and the universal one does include x86_64), so per-flavor ABI
        filters are required, not accidental.
    -->
    <issue id="ChromeOsAbiSupport" severity="ignore" />

    <!-- targetSdk 36 is the current stable release; lint is pointing at a newer preview. -->
    <issue id="OldTargetApi" severity="ignore" />

    <!--
        Manifest/resource attributes that only exist from a newer API level than minSdk (24).
        They are ignored by older platforms and are exactly what newer platforms need: the app
        declares them for the devices that understand them.
    -->
    <issue id="UnusedAttribute" severity="ignore" />

    <!-- Launcher and wordmark art comes from the design source files; not regenerated here. -->
    <issue id="IconLocation" severity="ignore" />
    <issue id="IconLauncherShape" severity="ignore" />
    <issue id="IconDuplicates" severity="ignore" />
    <issue id="VectorRaster" severity="ignore" />
    <issue id="VectorPath" severity="ignore" />

    <!--
        Hyphen versus en dash inside translated sentences is a per-language typography decision
        (a hyphen is correct in several of these locales) and lint only sees the English rule.
    -->
    <issue id="TypographyDashes" severity="ignore" />

    <!--
        "%d songs" should be a plural resource. Converting it means writing correct plural forms
        for every locale that currently holds a single string, so it is a translation task rather
        than a code fix; it is tracked instead of silently suppressed by deleting the strings.
    -->
    <issue id="PluralsCandidate" severity="ignore" />
    <issue id="UnusedQuantity" severity="ignore" />
    <issue id="ButtonCase" severity="ignore" />

    <!--
        The app changes locale itself (Settings -> App language) and deliberately does not depend on
        Play Core's split-install language API: it ships every locale and falls back to English.
    -->
    <issue id="AppBundleLocaleChanges" severity="ignore" />

</lint>
